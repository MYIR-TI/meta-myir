# /etc/systemd/system/wpa_supplicant-custom.service
[Unit]
Description=WiFi WPA Supplicant
After=network.target

[Service]
Type=simple
ExecStart=/usr/sbin/wpa_supplicant -c /etc/wpa_supplicant.conf -i mlan0 -D nl80211
ExecStop=/usr/sbin/wpa_cli -i wlan0 terminate
Restart=always
RestartSec=3
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=wpa_supplicant

[Install]
WantedBy=multi-user.target
